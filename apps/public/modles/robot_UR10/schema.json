  "params_schema": {
    "joint_speed_rad_s": {
      "type": "number",
      "required": true,
      "default": 0.8,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "rad/s",
      "min": 0.01,
      "max": 2
    },
    "joint_accel_rad_s2": {
      "type": "number",
      "required": true,
      "default": 1.5,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "rad/s²",
      "min": 0.01,
      "max": 5
    },
    "settle_speed_rad_s": {
      "type": "number",
      "required": true,
      "default": 0.01,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "rad/s",
      "min": 0.0001,
      "max": 0.1
    },
    "ik_position_tolerance_m": {
      "type": "number",
      "required": true,
      "default": 0.002,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "m",
      "min": 1e-05,
      "max": 0.02
    },
    "ik_max_iterations": {
      "type": "integer",
      "required": true,
      "default": 200,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "min": 1,
      "max": 1000
    },
    "ik_mode": {
      "type": "enum",
      "required": true,
      "default": "position_only",
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "options": [
        "position_only"
      ]
    },
    "max_payload_kg": {
      "type": "number",
      "required": true,
      "default": 5,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "kg",
      "min": 0.001,
      "max": 20
    },
    "lift_height": {
      "type": "number",
      "required": true,
      "default": 0.12,
      "mutability": "stopped_only",
      "description": "显式仿真实验配置，不代表实机额定参数",
      "unit": "m",
      "min": 0.01,
      "max": 0.4
