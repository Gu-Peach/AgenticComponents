          ]
        },
        "capabilities": {
          "snap": {
            "role": "workpiece",
            "accepts": [
              "fixture"
            ]
          }
        }
      }
    ],
    "type_specific_contract": {
      "coordinate_system": {
        "origin": "glb_material_root"
      },
      "process_geometry": {
        "regions": [
          {
            "region_id": "weld",
            "placement_rule": "mesh_036g_top_face"
          }
        ]
      },
      "grasping": {
