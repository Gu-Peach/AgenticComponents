{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.rotary_table",
  "device_spec_id": "standard.rotary_table",
  "version": "1.0.0",
  "device_type": "rotary_table",
  "display_name": "带载分度转台",
  "description": "通过同一个装卸接口承载工件，围绕竖直轴正向分度。",
  "asset": {
    "model_format": "glb",
    "model_key": "../Robot Welding cell/Robot Welding cell.glb",
    "sha256": "527ddb9592f311dda119b1a3006fffff540999a5bec21fee1b3ee3b5dc0bba11"
  },
  "params_schema": {
    "rotate_speed_deg_s": {
      "type": "number",
      "required": true,
      "default": 90,
      "unit": "°/s",
      "min": 0.1,
      "max": 360,
      "mutability": "runtime_setpoint",
      "description": "角速度上限"
    },
    "rotate_accel_deg_s2": {
      "type": "number",
      "required": true,
      "default": 180,
      "unit": "°/s²",
      "min": 0.1,
      "max": 720,
      "mutability": "stopped_only",
      "description": "角加速度上限"
    },
    "angle_tolerance_deg": {
      "type": "number",
      "required": true,
      "default": 1,
      "unit": "°",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "定位误差阈值"
    },
    "settle_speed_deg_s": {
      "type": "number",
      "required": true,
      "default": 0.1,
      "unit": "°/s",
      "min": 0,
      "max": 5,
      "mutability": "stopped_only",
      "description": "到位稳定的角速度阈值"
    },
    "capacity": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 50,
      "mutability": "stopped_only",
      "description": "允许同时承载数量"
    },
    "max_payload_kg": {
      "type": "number",
      "required": true,
      "default": 50,
      "unit": "kg",
      "min": 0.01,
      "max": 5000,
      "mutability": "stopped_only",
      "description": "允许载荷"
    }
  },
  "interfaces": [
    {
      "interface_id": "slot1",
      "name": "装卸承载点",
      "local_frame": {
        "position": [
          0.47999998927116394,
          0.7000002513825834,
          -4.1962931823791294e-08
        ],
        "forward": [
          0,
          1,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "capabilities": {
        "snap": {
          "role": "fixture",
          "accepts": [
            "workpiece"
          ]
        }
      }
    }
  ],
  "signal_ports": [
    {
      "port_id": "angleTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "任意目标角度，°；配置选择工位或角度模式，两者不同时驱动",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "°"
    },
    {
      "port_id": "rotate_to_station",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "原 command 的 PLC 投影；参数先写入，再请求一次定位，映射公共 execute 角色",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "request_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "原 command 的 PLC 投影；参数先写入，再请求一次定位，映射公共 execute 角色",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "actual_angle",
      "direction": "output",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "当前实际角度，°，用于到位和交接检查",
      "signal_role": "continuous_state",
      "retention": "sampled_state",
      "unit": "°"
    },
    {
      "port_id": "occupied",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前台面／指定交接区是否存在物料；作用范围必须在配置中固定",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "rotating",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "实际角速度是否超过静止容差",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "at_station",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "台面达到所选目标且已稳定；这是状态，不单独代表某次请求成功",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "accepted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "result_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "rotate_to_station",
      "display_name": "带载转位",
      "behavior_type": "action",
      "schedulable": true,
      "executor_ref": "rotary_table.rotate_to_station@1",
      "implementation_status": "implemented",
      "arguments_schema": {
        "angleTag": {
          "type": "number",
          "unit": "°",
          "min": 0,
          "max": 360,
          "required": true,
          "description": "正向旋转到的归一化角度",
          "mutability": "stopped_only"
        }
      },
      "trigger": {
        "description": "冻结请求身份、动作参数和载荷后，由调度器提交一次请求。",
        "authority": "single_gateway_or_declared_continuous_writer"
      },
      "input_signals": [
        "rotate_to_station",
        "angleTag",
        "request_id"
      ],
      "output_signals": [
        "accepted",
        "busy",
        "done",
        "result_id",
        "error",
        "actual_angle",
        "occupied",
        "rotating",
        "at_station"
      ],
      "condition_contract": {
        "preconditions": [
          {
            "id": "ready",
            "label": "本件已固定于唯一工装，转台静止，人员撤离，机器人退位。",
            "source": "observation",
            "key": "rotate_to_station.ready",
            "equals": true
          },
          {
            "id": "authorized",
            "label": "请求已获得转台及其载荷的控制权。",
            "source": "authorization",
            "key": "rotate_to_station.authorized",
            "equals": true
          }
        ],
        "sustaining_conditions": [
          {
            "id": "sustaining",
            "label": "载荷固定于同一工装，人员和机器人持续位于转位区外。",
            "source": "observation",
            "key": "rotate_to_station.sustaining",
            "equals": true
          }
        ],
        "missing_value_policy": "unknown_blocks_execution"
      },
      "completion_contract": {
        "mode": "observed",
        "description": "同件载荷仍在工装上，实际角度进入目标容差并停稳。",
        "checks": [
          {
            "id": "completion",
            "label": "同件载荷仍在工装上，实际角度进入目标容差并停稳。",
            "source": "observation",
            "key": "rotate_to_station.completion",
            "equals": true
          }
        ],
        "timer_or_progress_is_success": false
      }
    }
  ],
  "type_specific_contract": {
    "indexing_policy": {
      "direction": "positive",
      "angle_reference": "normalized_degrees",
      "home_deg": 0,
      "process_deg": 180
    },
    "capacity_model": {
      "capacity_param": "capacity"
    }
  },
  "runtime_contract": {
    "observation_definitions": {
      "rotate_to_station.ready": {
        "value_type": "boolean",
        "provider": "behavior_adapter",
        "implementation_status": "implemented",
        "signal_refs": [
          "rotate_to_station",
          "angleTag",
          "request_id",
          "accepted",
          "busy",
          "done",
          "result_id",
          "error",
          "actual_angle",
          "occupied",
          "rotating",
          "at_station"
        ],
        "expression_ref": "rotate_to_station.ready"
      },
      "rotate_to_station.sustaining": {
        "value_type": "boolean",
        "provider": "behavior_adapter",
        "implementation_status": "implemented",
        "signal_refs": [
          "rotate_to_station",
          "angleTag",
          "request_id",
          "accepted",
          "busy",
          "done",
          "result_id",
          "error",
          "actual_angle",
          "occupied",
          "rotating",
          "at_station"
        ],
        "expression_ref": "rotate_to_station.sustaining"
      },
      "rotate_to_station.completion": {
        "value_type": "boolean",
        "provider": "behavior_adapter",
        "implementation_status": "implemented",
        "signal_refs": [
          "rotate_to_station",
          "angleTag",
          "request_id",
          "accepted",
          "busy",
          "done",
          "result_id",
          "error",
          "actual_angle",
          "occupied",
          "rotating",
          "at_station"
        ],
        "expression_ref": "rotate_to_station.completion"
      }
    },
    "authorization_definitions": {
      "rotate_to_station.authorized": {
        "value_type": "boolean",
        "provider": "authorization_service",
        "implementation_status": "implemented",
        "signal_refs": [
          "rotate_to_station",
          "angleTag",
          "request_id",
          "accepted",
          "busy",
          "done",
          "result_id",
          "error",
          "actual_angle",
          "occupied",
          "rotating",
          "at_station"
        ],
        "expression_ref": "rotate_to_station.authorized"
      }
    },
    "condition_model": {
      "schema_version": "ac-condition/0.1",
      "execution_mode": "declaration_only",
      "unknown_policy": "three_valued_fail_closed",
      "bindings": {},
      "expressions": {
        "rotate_to_station.ready": {
          "status": "opaque",
          "expr": {
            "op": "opaque",
            "source": "observation",
            "key": "rotate_to_station.ready"
          }
        },
        "rotate_to_station.authorized": {
          "status": "opaque",
          "expr": {
            "op": "opaque",
            "source": "authorization",
            "key": "rotate_to_station.authorized"
          }
        },
        "rotate_to_station.sustaining": {
          "status": "opaque",
          "expr": {
            "op": "opaque",
            "source": "observation",
            "key": "rotate_to_station.sustaining"
          }
        },
        "rotate_to_station.completion": {
          "status": "opaque",
          "expr": {
            "op": "opaque",
            "source": "observation",
            "key": "rotate_to_station.completion"
          }
        }
      }
    }
  },
  "runtime_execution_contract": {
    "signal_management": {
      "owner": "simulation_engine",
      "status": "pending_engine",
      "namespace": "instance_id/port_id",
      "definition_source": "signal_ports",
      "spatial_binding": false,
      "write_policy": "single_writer_per_input",
      "plc_mapping": "instance_bindings",
      "sampling": "simulation_step_snapshot",
      "unknown_policy": "invalid_until_provider_ready"
    },
    "status": "implemented",
    "protocol": {
      "basis": "schema.md公共请求协议",
      "acceptance": "same request identity and frozen parameters",
      "completion": "matching result_id plus observed completion checks",
      "single_command_entry": true
    },
    "payload_binding_status": "requires_explicit_model_adapter",
    "calibration_required": true,
    "real_execution_available": false,
    "raw_api_and_plc_simultaneous_writers": false
  }
}
