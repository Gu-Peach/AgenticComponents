{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.workpiece_carrier",
  "device_spec_id": "standard.workpiece_carrier",
  "version": "1.0.0",
  "device_type": "workpiece_carrier",
  "display_name": "物料托盘／载具：槽位、承载与被动随动",
  "asset": {
    "model_format": "glb",
    "model_key": "../assembly_order_index/assembly_order_index.glb",
    "sha256": "c68cc1ea4219a6616e13b9c036da871ac0886be3e76f8ec3202c22faffda0249"
  },
  "params_schema": {
    "length_m": {
      "type": "number",
      "required": true,
      "default": 0.8,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "载具外形长度"
    },
    "width_m": {
      "type": "number",
      "required": true,
      "default": 0.45,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "载具外形宽度"
    },
    "height_m": {
      "type": "number",
      "required": true,
      "default": 0.08,
      "unit": "m",
      "min": 0.001,
      "max": 1,
      "mutability": "stopped_only",
      "description": "载具高度"
    },
    "empty_mass_kg": {
      "type": "number",
      "required": true,
      "default": 3,
      "unit": "kg",
      "min": 0.001,
      "max": 500,
      "mutability": "stopped_only",
      "description": "空载质量"
    },
    "max_load_kg": {
      "type": "number",
      "required": true,
      "default": 20,
      "unit": "kg",
      "min": 0.01,
      "max": 5000,
      "mutability": "stopped_only",
      "description": "可装载物料总质量上限"
    },
    "slot_rows": {
      "type": "integer",
      "required": true,
      "default": 3,
      "min": 1,
      "max": 20,
      "mutability": "stopped_only",
      "description": "沿局部 Z 的槽位行数"
    },
    "slot_columns": {
      "type": "integer",
      "required": true,
      "default": 4,
      "min": 1,
      "max": 20,
      "mutability": "stopped_only",
      "description": "沿局部 X 的槽位列数"
    },
    "slot_pitch_x_m": {
      "type": "number",
      "required": true,
      "default": 0.2,
      "unit": "m",
      "min": 0.001,
      "max": 2,
      "mutability": "stopped_only",
      "description": "相邻列中心距离"
    },
    "slot_pitch_z_m": {
      "type": "number",
      "required": true,
      "default": 0.12,
      "unit": "m",
      "min": 0.001,
      "max": 2,
      "mutability": "stopped_only",
      "description": "相邻行中心距离"
    },
    "edge_margin_m": {
      "type": "number",
      "required": true,
      "default": 0.05,
      "unit": "m",
      "min": 0,
      "max": 0.5,
      "mutability": "stopped_only",
      "description": "物料外廓与载具边缘最小距离"
    },
    "allow_partial_load": {
      "type": "boolean",
      "required": true,
      "default": true,
      "mutability": "stopped_only",
      "description": "是否允许未满载就参与运输"
    }
  },
  "interfaces": [],
  "signal_ports": [
    {
      "port_id": "loaded",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前载具至少装有一件物料；部分装载允许时不等同于满载",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "unloaded",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前没有已装载物料；卸载完成的离散事件另写 Runtime 日志",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "load_count",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "当前已确认装载数量，不包含尚未完成的装载请求",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "free_slots",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "扣除实际占用和有效预留后的可用槽位数",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "slot_available",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "对查询中指定槽位的可用状态；不能用一位同时表达全部槽位",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "in_transport",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前正在被其他执行设备搬运或输送",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "holder_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前搬运者或持有者 ID，由外层运行时更新",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    }
  ],
