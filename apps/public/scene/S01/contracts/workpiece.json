{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.workpiece",
  "device_spec_id": "standard.workpiece",
  "version": "1.0.0",
  "device_type": "workpiece",
  "display_name": "物料：被动对象与状态观测",
  "asset": {
    "model_format": "glb",
    "model_key": "../assembly_order_index/assembly_order_index.glb",
    "sha256": "c68cc1ea4219a6616e13b9c036da871ac0886be3e76f8ec3202c22faffda0249"
  },
  "params_schema": {
    "mass_kg": {
      "type": "number",
      "required": true,
      "default": 0.2,
      "unit": "kg",
      "min": 0.001,
      "max": 500,
      "mutability": "stopped_only",
      "description": "物料物理质量"
    },
    "shape": {
      "type": "enum",
      "required": true,
      "default": "cylinder",
      "options": [
        "cylinder",
        "box"
      ],
      "mutability": "stopped_only",
      "description": "参数化碰撞形状；复杂网格需另选几何配置"
    },
    "height_m": {
      "type": "number",
      "required": true,
      "default": 0.12,
      "unit": "m",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "高度"
    },
    "diameter_m": {
      "type": "number",
      "required": false,
      "default": 0.08,
      "unit": "m",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "圆柱直径",
      "required_when": {
        "parameter": "shape",
        "equals": "cylinder"
      }
    },
    "length_m": {
      "type": "number",
      "required": false,
      "default": 0.1,
      "unit": "m",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "盒形长度",
      "required_when": {
        "parameter": "shape",
        "equals": "box"
      }
    },
    "width_m": {
      "type": "number",
      "required": false,
      "default": 0.1,
      "unit": "m",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "盒形宽度",
      "required_when": {
        "parameter": "shape",
        "equals": "box"
      }
    },
    "friction": {
      "type": "number",
      "required": false,
      "default": 0.5,
      "unit": "ratio",
      "min": 0,
      "max": 2,
      "mutability": "stopped_only",
      "description": "接触摩擦参数"
    },
    "restitution": {
      "type": "number",
      "required": false,
      "default": 0,
      "unit": "ratio",
      "min": 0,
      "max": 1,
      "mutability": "stopped_only",
      "description": "恢复系数"
    },
    "can_stack": {
      "type": "boolean",
      "required": true,
      "default": false,
      "mutability": "stopped_only",
      "description": "是否允许作为合法堆叠对象"
    }
  },
  "interfaces": [
    {
      "interface_id": "mount_base",
      "name": "设备底部安装面",
      "local_frame_pending": true,
      "capabilities": {
        "snap": {
          "role": "mount_base",
          "accepts": [
            "carriage_mount"
          ]
        }
      }
    }
  ],
  "signal_ports": [
    {
      "port_id": "picked",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "本次实际建立持有关系的锁存通知，带事件／任务关联；不是每个抓取命令都算成功",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "carried",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前物料是否被有效持有，属于持续状态",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "placed",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前物料已完成有效放置并满足配置的稳定条件；上层可另发放置事件",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "holder_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前持有设备／载具的映射 ID，0 表示未被持有",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "location_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前确认的位置或工艺区域；未知位置必须有明确编码",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    }
  ],
