        "payload_binding_status": "signal_or_external_event"
      },
      "input_signals": [],
      "output_signals": [
        "carried",
        "holder_id",
        "picked"
      ],
      "condition_contract": {
        "preconditions": [
          {
            "id": "pre_1",
            "label": "物料存在且可抓、几何可接触、无冲突持有或预留、夹具及载荷兼容",
            "source": "observation",
            "key": "be_picked.pre_1",
            "equals": true
          }
        ],
        "sustaining_conditions": [
          {
            "id": "sustaining",
            "label": "持续条件与阶段身份",
            "source": "observation",
            "key": "be_picked.sustaining",
            "equals": true
          }
        ],
        "missing_value_policy": "unknown_blocks_execution"
      },
      "completion_contract": {
        "mode": "observed",
        "description": "实际持有关系建立，发布 picked 并更新 carried/holder_id",
        "checks": [
          {
            "id": "completion_evidence",
            "label": "实际持有关系建立，发布 picked 并更新 carried/holder_id",
            "source": "observation",
            "key": "be_picked.completion",
            "equals": true
          }
        ],
        "timer_or_progress_is_success": false
      },
      "applicability": {
        "status": "must_check_configuration",
        "conditions": []
