  "legacy_inputs": "not_loaded_by_scene_runtime",
  "assumptions": [
    "物流方向由用户确认：载料托盘从主滚筒线左端进入，两机械臂取料并送入各自绿色出料线，空盘从主线末端离开。",
    "A/B为实验物料类别，分类动作及目标出料线由DSL声明；batch只保存物料及初始装载。",
    "R1/R2分别绑定图中两机械臂；C2/C3分别为其对应的绿色出料线。准确节点和可达范围仍待标定。",
    "托盘槽位随载具移动，抓取改变实际库存后才确认拆垛；不能将托盘支承丢失或旧完成信号当成功。",
    "输入、下游接收、空盘移出均需真实关联证据；未知观测不默认满足。",
    "位置顺序与机械臂可达工位是场景物理事实，具体停止步骤和类别分流由process.py声明。",
    "共同分度设计：两工位可同时停靠托盘，只有两台机械臂完成并退位后才统一前进；节距和过渡容量仍待验证。"
  ],
  "motion_interlocks": {},
  "execution_defaults": {
    "tick_hz": 60,
    "deadline_ticks": 72000,
    "scheduler": "declarative_control_tree_with_atomic_authorization",
    "on_failure": "stop_admissions_cancel_siblings_confirm_stops_or_attention"
  }
