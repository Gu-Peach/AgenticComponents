    "completion": "independent_goal_monitor",
    "precondition_timeout_s": 30,
    "acceptance_timeout_s": 30,
    "execution_timeout_s": 120,
    "stop_timeout_s": 30,
    "collection_timeout_s": 30,
    "finalization_timeout_s": 30,
    "unknown_policy": "block_then_fail_on_deadline",
    "on_failure": "stop_admissions_cancel_siblings_stop_drives_confirm_or_attention",
    "status": "pending_runtime"
  },
  "iteration_contracts": {},
  "collection_bindings": {
    "items_at": {
      "status": "pending_provider",
      "fields": {
        "material": "material_ref",
        "source": "location_ref"
      },
      "source": "current_station_carrier_inventory",
      "freeze": "at_repeat_activation",
      "unknown_policy": "block_not_empty",
      "side_effects": false,
      "admission": {
        "mode": "automatic_before_snapshot",
        "requirements": [
          "station actually stopped",
          "carrier identity and inventory revision known"
        ],
        "timeout_policy": "process_contract.collection_timeout_s"
      }
    }
  },
  "environment": [
    {
      "kind": "external_loaded_carrier_infeed",
      "rule": "admit_next_manifest_pallet_only_when_entry_clear_and_line_stopped; at_most_one_per_cycle",
      "implementation_status": "pending"
    },
    {
      "kind": "external_takeaway",
      "rule": "confirm_matching_material_at_stopped_green_output_then_remove",
      "implementation_status": "pending"
    },
    {
      "kind": "external_empty_carrier_takeaway",
      "rule": "confirm_empty_carrier_at_stopped_C1_exit_then_remove_before_next_advance",
      "implementation_status": "pending"
    }
  ],
  "initial": {
    "materials": "registered_finite_inventory",
