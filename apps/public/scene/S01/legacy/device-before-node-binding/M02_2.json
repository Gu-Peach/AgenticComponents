        "signal_role": "continuous_state",
        "retention": "sampled_state"
      },
      {
        "port_id": "location_id",
        "direction": "output",
        "value_type": "integer",
        "plc_type": "DINT",
        "description": "当前确认的位置或工艺区域；未知位置必须有明确编码",
