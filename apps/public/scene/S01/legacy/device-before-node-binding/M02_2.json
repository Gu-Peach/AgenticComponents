    "schema_type": "DeviceSpec",
    "schema_id": "standard.workpiece",
    "device_spec_id": "standard.workpiece",
    "version": "1.0.0",
    "device_type": "workpiece",
    "display_name": "物料：被动对象与状态观测",
    "description": "依据三份规范定义的可复用声明模板；参数为示例值，节点/几何/提供者均需适配。",
    "asset": {
      "model_format": "glb",
      "model_key": "unbound/workpiece",
      "binding_status": "requires_instance_asset_mapping"
    },
    "params_schema": {
      "mass_kg": {
        "type": "number",
        "required": true,
        "default": 0.2,
        "unit": "kg",
        "min": 0.001,
        "max": 500,
        "mutability": "stopped_only",
        "description": "物料物理质量"
      },
      "shape": {
        "type": "enum",
        "required": true,
        "default": "cylinder",
        "options": [
          "cylinder",
          "box"
        ],
        "mutability": "stopped_only",
        "description": "参数化碰撞形状；复杂网格需另选几何配置"
      },
      "height_m": {
        "type": "number",
        "required": true,
        "default": 0.12,
        "unit": "m",
        "min": 0.001,
        "max": 5,
        "mutability": "stopped_only",
        "description": "高度"
      },
      "diameter_m": {
        "type": "number",
        "required": false,
        "default": 0.08,
        "unit": "m",
        "min": 0.001,
        "max": 5,
        "mutability": "stopped_only",
        "description": "圆柱直径",
        "required_when": {
          "parameter": "shape",
          "equals": "cylinder"
        }
      },
      "length_m": {
        "type": "number",
        "required": false,
        "default": 0.1,
        "unit": "m",
        "min": 0.001,
        "max": 5,
        "mutability": "stopped_only",
        "description": "盒形长度",
        "required_when": {
          "parameter": "shape",
          "equals": "box"
        }
      },
      "width_m": {
        "type": "number",
        "required": false,
        "default": 0.1,
        "unit": "m",
        "min": 0.001,
        "max": 5,
        "mutability": "stopped_only",
        "description": "盒形宽度",
        "required_when": {
          "parameter": "shape",
          "equals": "box"
        }
      },
      "friction": {
        "type": "number",
        "required": false,
        "default": 0.5,
        "unit": "ratio",
        "min": 0,
        "max": 2,
        "mutability": "stopped_only",
        "description": "接触摩擦参数"
      },
      "restitution": {
        "type": "number",
        "required": false,
        "default": 0,
        "unit": "ratio",
        "min": 0,
        "max": 1,
        "mutability": "stopped_only",
        "description": "恢复系数"
      },
      "can_stack": {
        "type": "boolean",
        "required": true,
        "default": false,
        "mutability": "stopped_only",
        "description": "是否允许作为合法堆叠对象"
      }
    },
    "interfaces": [],
    "signal_ports": [
      {
        "port_id": "picked",
        "direction": "output",
        "value_type": "boolean",
        "plc_type": "BOOL",
        "description": "本次实际建立持有关系的锁存通知，带事件／任务关联；不是每个抓取命令都算成功",
        "signal_role": "result_latched",
        "retention": "latched_until_ack_or_new_request"
