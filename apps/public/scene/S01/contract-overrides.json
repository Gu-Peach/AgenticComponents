{
  "conveyor/position": {
    "$remove": [
      "description"
    ],
    "signal_ports": {
      "$list": "port_id",
      "entries": {
        "done": {
          "description": "本次有限任务满足对应行为的完成契约；关联result_id，连续空转没有全局完成",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "request_id": {
          "description": "schema.md公共请求协议：request_id",
          "signal_role": "request_parameter",
          "retention": "latched_until_ack_or_new_request"
        },
        "accepted": {
          "description": "schema.md公共请求协议：accepted",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "result_id": {
          "description": "schema.md公共请求协议：result_id",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        }
      }
    },
    "runtime_execution_contract": {
      "$remove": [
        "semantic_ports"
      ]
    }
  },
  "material_source_station/position": {
    "$remove": [
      "description"
    ],
    "signal_ports": {
      "$list": "port_id",
      "entries": {
        "request_id": {
          "description": "请求生产一件；持续 TRUE 不连续创建重复请求",
          "signal_role": "request_parameter",
          "retention": "sampled_state"
        },
        "accepted": {
          "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "done": {
          "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "result_id": {
          "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        }
      }
    }
  },
  "robot_arm/position": {
    "version": "1.0.0",
    "transport_behaviors": {
      "$list": "behavior_id",
      "select": [
        "execute_job",
        "pick_and_place",
        "move_to_pose",
        "grip",
        "release",
        "wait_time",
        "wait_signal",
        "set_output",
        "pause_pick_intake",
        "resume_pick_intake",
        "hold_motion",
        "resume_motion",
        "publish_robot_state"
      ]
    },
    "runtime_contract": {
      "observation_definitions": {
        "$remove": [
          "pick_and_handoff.ready",
          "pick_and_handoff.integrity",
          "pick_and_handoff.complete",
          "place_held_material.ready",
          "place_held_material.integrity",
          "place_held_material.complete"
        ]
      },
      "authorization_definitions": {
        "$remove": [
          "pick_and_handoff.authorized",
          "place_held_material.authorized"
        ]
      },
      "condition_model": {
        "bindings": {
          "move_to_pose.busy_run": {
            "kind": "signal",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "device": "self",
            "port": "busy",
            "scope": "run",
            "required_quality": "good",
            "freshness": "signal_definition"
          },
          "move_to_pose.error_run": {
            "kind": "signal",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "device": "self",
            "port": "error",
            "scope": "run",
            "required_quality": "good",
            "freshness": "signal_definition"
          },
          "move_to_pose.pose_plan_valid": {
            "kind": "observation",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "provider": "scene.robot_arm.pose_plan_valid@1",
            "description": "目标解析、关节限制、请求模式及可执行路径检查；使能命令由网关提交，不能等待自己的启动输入。",
            "scope": "run",
            "arguments": {
              "device": {
                "from": "self"
              },
              "target": {
                "from": "payload",
                "name": "target"
              }
            },
            "sample_keys": [
              "world/state"
            ],
            "max_age_ticks": 1,
            "implementation_status": "pending_provider_binding"
          },
          "move_to_pose.matching_accepted": {
            "kind": "request",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "field": "matching_accepted",
            "scope": "request",
            "implementation_status": "pending_request_trace_binding"
          },
          "move_to_pose.motion_integrity": {
            "kind": "observation",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "provider": "scene.robot_arm.motion_integrity@1",
            "description": "当前请求的实际运动与允许工作区证据。",
            "scope": "request",
            "arguments": {
              "device": {
                "from": "self"
              },
              "target": {
                "from": "payload",
                "name": "target"
              }
            },
            "sample_keys": [
              "{self}/robot_state"
            ],
            "max_age_ticks": 1,
            "implementation_status": "pending_provider_binding"
          },
          "move_to_pose.matching_success": {
            "kind": "request",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "field": "matching_success",
            "scope": "request",
            "implementation_status": "pending_request_trace_binding"
          },
          "move_to_pose.tcp_position_error_m": {
            "kind": "observation",
            "behavior": "move_to_pose",
            "value_type": "number",
            "unit": "m",
            "provider": "scene.robot_arm.tcp_position_error_m@1",
            "description": "实际 TCP 相对本次目标的位置误差。",
            "scope": "request",
            "arguments": {
              "device": {
                "from": "self"
              },
              "target": {
                "from": "payload",
                "name": "target"
              }
            },
            "sample_keys": [
              "{self}/robot_state"
            ],
            "max_age_ticks": 1,
            "implementation_status": "pending_provider_binding"
          },
          "move_to_pose.ik_position_tolerance_m": {
            "kind": "parameter",
            "behavior": "move_to_pose",
            "value_type": "number",
            "unit": "m",
            "parameter": "ik_position_tolerance_m"
          },
          "move_to_pose.max_joint_speed_rad_s": {
            "kind": "observation",
            "behavior": "move_to_pose",
            "value_type": "number",
            "unit": "rad/s",
            "provider": "scene.robot_arm.max_joint_speed_rad_s@1",
            "description": "实际各关节角速度绝对值最大值。",
            "scope": "request",
            "arguments": {
              "device": {
                "from": "self"
              },
              "target": {
                "from": "payload",
                "name": "target"
              }
            },
            "sample_keys": [
              "{self}/robot_state"
            ],
            "max_age_ticks": 1,
            "implementation_status": "pending_provider_binding"
          },
          "move_to_pose.settle_speed_rad_s": {
            "kind": "parameter",
            "behavior": "move_to_pose",
            "value_type": "number",
            "unit": "rad/s",
            "parameter": "settle_speed_rad_s"
          },
          "move_to_pose.requested_orientation_satisfied": {
            "kind": "observation",
            "behavior": "move_to_pose",
            "value_type": "boolean",
            "unit": "1",
            "provider": "scene.robot_arm.requested_orientation_satisfied@1",
            "description": "仅在请求要求姿态时检查姿态误差；position_only 不能被表述为已完成任意姿态控制。",
            "scope": "request",
            "arguments": {
              "device": {
                "from": "self"
              },
              "target": {
                "from": "payload",
                "name": "target"
              }
            },
            "sample_keys": [
              "{self}/robot_state"
            ],
            "max_age_ticks": 1,
            "implementation_status": "pending_provider_binding"
          }
        },
        "expressions": {
          "$remove": [
            "pick_and_handoff.ready",
            "pick_and_handoff.authorized",
            "pick_and_handoff.integrity",
            "pick_and_handoff.complete",
            "place_held_material.ready",
            "place_held_material.authorized",
            "place_held_material.integrity",
            "place_held_material.complete"
          ],
          "move_to_pose.pre_1": {
            "status": "structured",
            "expr": {
              "$remove": [
                "key",
                "source"
              ],
              "op": "all",
              "args": [
                {
                  "op": "not",
                  "arg": {
                    "op": "ref",
                    "binding": "move_to_pose.busy_run"
                  }
                },
                {
                  "op": "not",
                  "arg": {
                    "op": "ref",
                    "binding": "move_to_pose.error_run"
                  }
                },
                {
                  "op": "ref",
                  "binding": "move_to_pose.pose_plan_valid"
                }
              ]
            }
          },
          "move_to_pose.sustaining": {
            "status": "structured",
            "expr": {
              "$remove": [
                "key",
                "source"
              ],
              "op": "all",
              "args": [
                {
                  "op": "ref",
                  "binding": "move_to_pose.matching_accepted"
                },
                {
                  "op": "not",
                  "arg": {
                    "op": "ref",
                    "binding": "move_to_pose.error_run"
                  }
                },
                {
                  "op": "ref",
                  "binding": "move_to_pose.motion_integrity"
                }
              ]
            }
          },
          "move_to_pose.completion": {
            "status": "structured",
            "expr": {
              "$remove": [
                "key",
                "source"
              ],
              "op": "all",
              "args": [
                {
                  "op": "ref",
                  "binding": "move_to_pose.matching_success"
                },
                {
                  "op": "compare",
                  "operator": "le",
                  "left": {
                    "op": "ref",
                    "binding": "move_to_pose.tcp_position_error_m"
                  },
                  "right": {
                    "op": "ref",
                    "binding": "move_to_pose.ik_position_tolerance_m"
                  }
                },
                {
                  "op": "compare",
                  "operator": "le",
                  "left": {
                    "op": "ref",
                    "binding": "move_to_pose.max_joint_speed_rad_s"
                  },
                  "right": {
                    "op": "ref",
                    "binding": "move_to_pose.settle_speed_rad_s"
                  }
                },
                {
                  "op": "ref",
                  "binding": "move_to_pose.requested_orientation_satisfied"
                }
              ]
            }
          }
        }
      }
    },
    "runtime_execution_contract": {
      "payload_templates": {
        "$remove": [
          "pick_and_handoff",
          "place_held_material"
        ]
      }
    }
  },
