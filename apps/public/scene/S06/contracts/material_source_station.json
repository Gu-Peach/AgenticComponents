{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.material_source_station",
  "device_spec_id": "standard.material_source_station",
  "version": "1.0.0",
  "device_type": "material_source_station",
  "display_name": "出料口／物料源工位：按需生产与节拍出料",
  "asset": {
    "model_format": "glb",
    "model_key": "../PM Assembly Pallet Recycling/PM Assembly Pallet Recycling.glb",
    "sha256": "8524e75af80d00a1a4a3fad32e20cb840ec95defb61a820a54145dd7424346c2"
  },
  "params_schema": {
    "production_mode": {
      "type": "enum",
      "required": true,
      "default": "on_demand",
      "options": [
        "on_demand",
        "periodic"
      ],
      "mutability": "stopped_only",
      "description": "按需单件或周期生产"
    },
    "cycle_time_s": {
      "type": "number",
      "required": true,
      "default": 5,
      "unit": "s",
      "min": 0.01,
      "max": 3600,
      "mutability": "stopped_only",
      "description": "一个生产周期的有效仿真时长"
    },
    "buffer_capacity": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 100,
      "mutability": "stopped_only",
      "description": "源端缓冲容量"
    },
    "product_spec": {
      "type": "string",
      "required": true,
      "default": "workpiece_1",
      "mutability": "stopped_only",
      "description": "被生成物料定义的引用 ID"
    },
    "buffer_length_m": {
      "type": "number",
      "required": true,
      "default": 0.6,
      "unit": "m",
      "min": 0.01,
      "max": 10,
      "mutability": "stopped_only",
      "description": "缓冲有效长度"
    },
    "buffer_width_m": {
      "type": "number",
      "required": true,
      "default": 0.4,
      "unit": "m",
      "min": 0.01,
      "max": 10,
      "mutability": "stopped_only",
      "description": "缓冲有效宽度"
    },
    "fixed_interval": {
      "type": "boolean",
      "required": false,
      "default": true,
      "mutability": "stopped_only",
      "description": "周期模式是否采用固定间隔",
      "required_when": {
        "parameter": "production_mode",
        "equals": "periodic"
      }
    },
    "interval_jitter_ratio": {
      "type": "number",
      "required": false,
      "default": 0.5,
      "unit": "ratio",
      "min": 0,
      "max": 0.99,
      "mutability": "stopped_only",
      "description": "随机周期相对扰动比例"
    },
    "random_seed": {
      "type": "integer",
      "required": false,
      "default": 1,
      "min": 0,
      "max": 2147483647,
      "mutability": "stopped_only",
      "description": "可复现随机种子"
    },
    "vary_attribute": {
      "type": "string",
      "required": false,
      "default": "",
      "mutability": "stopped_only",
      "description": "可选产品变化属性名"
    }
  },
  "interfaces": [
    {
      "interface_id": "mount_base",
      "name": "设备底部安装面",
      "local_frame_pending": true,
      "capabilities": {
        "snap": {
          "role": "mount_base",
          "accepts": [
            "carriage_mount"
          ]
        }
      }
    }
  ],
  "signal_ports": [
    {
      "port_id": "runTag",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "持续生产许可；第一版关闭后暂停周期推进、拒绝新请求，保留已接受任务及容量预留，恢复后继续",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "produce_request",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "请求生产一件；持续 TRUE 不连续创建重复请求",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "request_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "请求生产一件；持续 TRUE 不连续创建重复请求",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "reset",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "故障原因消失后请求复位",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "countTag",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "本方案定义为实际成功生成／呈现的累计数量；与 Open-Industry 的生成请求计数区分",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "material_available",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "出口当前有可取物料，取走后清除；上层另发一次到料事件",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "empty",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前缓冲区无可取物料；不等同于永久耗尽原料",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "buffer_count",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "当前缓冲物料数量",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "accepted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "result_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error_code",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "按需生产的请求与结果反馈；连续生产使用每件物料的事件日志和计数",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    }
  ],
