{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.lift_table",
  "device_spec_id": "standard.lift_table",
  "version": "1.2.0",
  "device_type": "lift_table",
  "display_name": "升降台：高度定位与可选横移模块",
  "asset": {
    "model_format": "glb",
    "model_key": "../Intelligent Storage and Logistics Line/PM Stacker Cranes.glb",
    "sha256": "11bb5e2a0865c27e75836e23fc9a5cd7678216eea494aaf408b93c14d4b5d353"
  },
  "params_schema": {
    "lift_speed_mps": {
      "type": "number",
      "required": true,
      "default": 0.2,
      "unit": "m/s",
      "min": 0.001,
      "max": 1,
      "mutability": "runtime_setpoint",
      "description": "主升降速度上限"
    },
    "lift_accel_mps2": {
      "type": "number",
      "required": true,
      "default": 0.4,
      "unit": "m/s²",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "升降加减速能力"
    },
    "min_height_m": {
      "type": "number",
      "required": true,
      "default": 0.3,
      "unit": "m",
      "min": 0,
      "max": 10,
      "mutability": "stopped_only",
      "description": "最低允许平台高度"
    },
    "max_height_m": {
      "type": "number",
      "required": true,
      "default": 2,
      "unit": "m",
      "min": 0.01,
      "max": 10,
      "mutability": "stopped_only",
      "description": "最高允许平台高度"
    },
    "upper_level_m": {
      "type": "number",
      "required": true,
      "default": 1.8,
      "unit": "m",
      "min": 0,
      "max": 10,
      "mutability": "stopped_only",
      "description": "本示例上层工位高度"
    },
    "platform_length_m": {
      "type": "number",
      "required": true,
      "default": 1.2,
      "unit": "m",
      "min": 0.1,
      "max": 5,
      "mutability": "stopped_only",
      "description": "平台长度"
    },
    "platform_width_m": {
      "type": "number",
      "required": true,
      "default": 1,
      "unit": "m",
      "min": 0.1,
      "max": 5,
      "mutability": "stopped_only",
      "description": "平台宽度"
    },
    "max_payload_kg": {
      "type": "number",
      "required": true,
      "default": 100,
      "unit": "kg",
      "min": 0.1,
      "max": 5000,
      "mutability": "stopped_only",
      "description": "允许载荷上限，需设备依据"
    },
    "position_tolerance_m": {
      "type": "number",
      "required": true,
      "default": 0.02,
      "unit": "m",
      "min": 0.0001,
      "max": 0.1,
      "mutability": "stopped_only",
      "description": "层高及定位误差界"
    },
    "settle_speed_mps": {
      "type": "number",
      "required": true,
      "default": 0.001,
      "unit": "m/s",
      "min": 0,
      "max": 0.05,
      "mutability": "stopped_only",
      "description": "到位时允许的剩余速度"
    },
    "transfer_module": {
      "type": "boolean",
      "required": true,
      "default": false,
      "mutability": "stopped_only",
      "description": "是否有独立辅助横移机构"
    },
    "transfer_speed_mps": {
      "type": "number",
      "required": true,
      "default": 0.35,
      "unit": "m/s",
      "min": 0.001,
      "max": 2,
      "mutability": "stopped_only",
      "description": "Explicit candidate simulation parameter; not a hardware measurement"
    },
    "popup_stroke_m": {
      "type": "number",
      "required": false,
      "default": 0.08,
      "unit": "m",
      "min": 0.001,
      "max": 0.5,
      "mutability": "stopped_only",
      "description": "辅助机构行程",
      "required_when": {
        "parameter": "transfer_module",
        "equals": true
      }
    },
    "transfer_accel_mps2": {
      "type": "number",
      "required": true,
      "default": 0.7,
      "unit": "m/s²",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "Explicit candidate simulation parameter; not a hardware measurement"
    },
    "transfer_max_distance_m": {
      "type": "number",
      "required": true,
      "default": 2,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "Explicit candidate simulation parameter; not a hardware measurement"
    }
  },
  "interfaces": [
    {
      "interface_id": "mount_base",
      "name": "设备底部安装面",
      "local_frame_pending": true,
      "capabilities": {
        "snap": {
          "role": "mount_base",
          "accepts": [
            "carriage_mount"
          ]
        }
      }
    }
  ],
  "signal_ports": [
    {
      "port_id": "move_to_level",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "保留手稿 REAL 改型，明确表示目标高度，m；不再同时携带字符串 target",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "m"
    },
    {
      "port_id": "target_level",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "目标层编号，由 height_levels 映射到高度；配置选择层号或高度模式，二者不同时驱动",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "execute",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "目标参数写好后发起一次升降请求，采用公共握手",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "request_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "目标参数写好后发起一次升降请求，采用公共握手",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "enableTag",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "主升降动作使能；失能时拒绝新请求，运行中按已实现的减速保持策略处理",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "reset",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "符合恢复条件时复位故障，不直接使平台瞬移或释放载荷",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "actual_height",
      "direction": "output",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "实际平台高度，m",
      "signal_role": "continuous_state",
      "retention": "sampled_state",
      "unit": "m"
    },
    {
      "port_id": "moving",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "平台当前是否仍在运动；不同于任务是否未完成",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "at_level",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "实际高度在目标容差内且速度已稳定；空闲状态也可能成立",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "accepted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "result_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error_code",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "公共动作反馈；done 必须对应本次已接受任务",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "popupTag",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "辅助链条机构抬升／下降；不能同时作为主高度轴的第二个控制来源",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "speedTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "横向输送速度，按单位模式选择；不是升降轴速度",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "m/s"
    },
    {
      "port_id": "speedFpmTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "横向输送速度，按单位模式选择；不是升降轴速度",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "ft/min"
    },
    {
      "port_id": "transfer_ready",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "主平台和辅助机构满足交接位置，且允许横移",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    }
  ],
  "transport_behaviors": [
