  },
  "params_schema": {
    "rows": {
      "type": "integer",
      "required": true,
      "default": 3,
      "min": 1,
      "max": 20,
      "mutability": "stopped_only",
      "description": "垂直层数"
    },
    "columns": {
      "type": "integer",
      "required": true,
      "default": 3,
      "min": 1,
      "max": 50,
      "mutability": "stopped_only",
      "description": "水平方向列数"
    },
    "cell_width_m": {
      "type": "number",
      "required": true,
      "default": 0.8,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "单库位净宽"
    },
    "cell_depth_m": {
      "type": "number",
      "required": true,
      "default": 0.8,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "单库位净深"
    },
    "cell_height_m": {
      "type": "number",
      "required": true,
      "default": 0.6,
      "unit": "m",
      "min": 0.01,
      "max": 5,
      "mutability": "stopped_only",
      "description": "单库位净高"
    },
    "cell_gap_x_m": {
      "type": "number",
      "required": true,
      "default": 0.05,
