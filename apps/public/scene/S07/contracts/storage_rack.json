  "interfaces": [],
  "signal_ports": [
    {
      "port_id": "cell_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "当前操作的库位编号，通过绑定表映射到 A1 等业务 ID",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "material_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前物料及任务身份；使用登记表映射，不把任意字符串强制转换成数字",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "owner_task_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前物料及任务身份；使用登记表映射，不把任意字符串强制转换成数字",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "reserve_request",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "请求为指定任务预留库位",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "store_request",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "发起本次入库交接；不直接把物料位置改写为库位位置",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "release_request",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "请求出库，等待搬运设备取走与交接确认",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "cancel_reservation",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "请求取消尚未完成交接的有效预留；不能清除仍有物料的真实占用",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "request_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "公共请求关联与故障复位；同一请求只允许一个操作入口",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "reset",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共请求关联与故障复位；同一请求只允许一个操作入口",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "reservation_granted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "预留结果及关联标识，明确授权给哪个任务",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "reservation_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "预留结果及关联标识，明确授权给哪个任务",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "cell_available",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "所选库位可供新的合法任务预留；已被其他任务预留时即不可用",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "cell_full",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "所选库位实际容量已满；“有预留”与“已放入物料”分开表示",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "free_cells",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "当前可预留库位数，排除已占用和有效预留",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "stored",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "入库／出库成功的锁存结果，关联 result_id；上层同步产生相应业务事件",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "released",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "入库／出库成功的锁存结果，关联 result_id；上层同步产生相应业务事件",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "accepted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "result_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
