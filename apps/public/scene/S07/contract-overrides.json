  "lift_table/warehouse": {
    "signal_ports": {
      "$list": "port_id",
      "entries": {
        "request_id": {
          "description": "目标参数写好后发起一次升降请求，采用公共握手",
          "signal_role": "request_parameter",
          "retention": "sampled_state"
        },
        "accepted": {
          "description": "公共动作反馈；done 必须对应本次已接受任务",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "done": {
          "description": "公共动作反馈；done 必须对应本次已接受任务",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "result_id": {
          "description": "公共动作反馈；done 必须对应本次已接受任务",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        }
      }
    },
    "transport_behaviors": {
      "$list": "behavior_id",
      "select": [
        "accept_material",
        "release_material",
        "transfer_material",
        "lift_to_location",
        "lift_to_level",
        "hold_lift"
      ]
    },
    "runtime_contract": {
      "observation_definitions": {
        "$remove": [
          "resume_lift.sustaining",
          "resume_lift.completion",
          "raise_transfer_chains.pre_1",
          "raise_transfer_chains.pre_2",
          "raise_transfer_chains.sustaining",
          "raise_transfer_chains.completion",
          "lower_transfer_chains.pre_1",
          "lower_transfer_chains.pre_2",
          "lower_transfer_chains.pre_3",
          "lower_transfer_chains.sustaining",
          "lower_transfer_chains.completion"
        ]
      },
      "authorization_definitions": {
        "$remove": [
          "resume_lift.pre_1"
        ]
      },
      "condition_model": {
        "expressions": {
          "$remove": [
            "resume_lift.pre_1",
            "resume_lift.sustaining",
            "resume_lift.completion",
            "raise_transfer_chains.pre_1",
            "raise_transfer_chains.pre_2",
            "raise_transfer_chains.sustaining",
            "raise_transfer_chains.completion",
            "lower_transfer_chains.pre_1",
            "lower_transfer_chains.pre_2",
            "lower_transfer_chains.pre_3",
            "lower_transfer_chains.sustaining",
            "lower_transfer_chains.completion"
          ]
        }
      }
    },
    "description": "仓储升降机的竖直定位与平台货叉交接；由外部 linear_rail 设备搭载。",
    "runtime_execution_contract": {
      "$remove": [
        "semantic_ports"
      ]
    }
  },
  "linear_rail/warehouse": {
    "description": "固定导轨与移动设备组合的单自由度轴；只驱动挂载升降机整体，不直接输送独立物料。",
    "signal_ports": {
      "$list": "port_id",
      "select": [
        "target_position",
        "execute",
        "request_id",
        "stop",
        "enable",
        "actual_position",
        "actual_speed",
        "accepted",
        "busy",
        "done",
        "result_id",
        "error",
        "error_code"
      ],
      "entries": {
        "request_id": {
          "description": "request_id；必须关联当前运行与请求",
          "signal_role": "request_parameter",
          "retention": "sampled_state"
        },
        "accepted": {
          "description": "accepted；必须关联当前运行与请求",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "done": {
          "description": "done；必须关联当前运行与请求",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "result_id": {
          "description": "result_id；必须关联当前运行与请求",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "error_code": {
          "plc_type": "DINT"
        }
      }
    },
    "runtime_execution_contract": {
      "$remove": [
        "semantic_ports"
      ]
    }
  },
  "storage_rack/warehouse": {
    "$remove": [
      "description"
    ],
    "signal_ports": {
      "$list": "port_id",
      "entries": {
        "request_id": {
          "description": "公共请求关联与故障复位；同一请求只允许一个操作入口",
          "signal_role": "request_parameter",
          "retention": "sampled_state"
        },
        "accepted": {
          "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "done": {
          "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        },
        "result_id": {
          "description": "当前仓储操作的公共结果；不能代替搬运设备自身的完成反馈",
          "signal_role": "result_latched",
          "retention": "latched_until_ack_or_new_request"
        }
      }
    }
  }
}
