  "device_type": "linear_rail",
  "display_name": "直线滑轨：搭载设备水平定位",
  "description": "滑轨类型契约。设备型号选择适用行为并绑定真实模型、参数与条件提供者。",
  "asset": {
    "model_format": "glb",
    "model_key": "unbound/linear_rail",
    "binding_status": "requires_instance_asset_mapping"
  },
  "params_schema": {
    "travel_speed_mps": {
      "type": "number",
      "required": true,
      "default": 0.2,
      "unit": "m/s",
      "min": 0.001,
      "max": 2,
      "mutability": "stopped_only",
      "description": "实验速度上限，待标定"
    },
    "travel_accel_mps2": {
      "type": "number",
      "required": true,
      "default": 0.4,
      "unit": "m/s²",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "实验加速度，待标定"
    },
    "position_tolerance_m": {
      "type": "number",
      "required": true,
      "default": 0.005,
      "unit": "m",
      "min": 0.0001,
      "max": 0.1,
      "mutability": "stopped_only",
      "description": "定位容差，待标定"
    },
    "settle_speed_mps": {
      "type": "number",
      "required": true,
      "default": 0.001,
      "unit": "m/s",
      "min": 0,
      "max": 0.05,
      "mutability": "stopped_only",
      "description": "停稳速度阈值，待标定"
    }
  },
  "interfaces": [
    {
      "interface_id": "mount_base",
      "name": "设备底部安装面",
      "local_frame_pending": true,
      "capabilities": {
        "snap": {
          "role": "mount_base",
          "accepts": [
            "carriage_mount"
          ]
        }
      }
    },
    {
      "interface_id": "carriage_mount",
      "name": "滑座移动安装面",
