{
  "name": "agentic-components-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "format": "prettier --write src tests e2e scripts README.md docs/动画接入指南.md *.json *.ts *.mjs",
    "format:check": "prettier --check src tests e2e scripts README.md docs/动画接入指南.md *.json *.ts *.mjs",
    "catalog:models": "node scripts/build-model-catalog.mjs",
    "predev": "npm run catalog:models",
    "prebuild": "npm run catalog:models"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
