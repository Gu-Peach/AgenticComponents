{
  "type": "object",
  "properties": {
    "ir_version": {
      "const": "0.1"
    },
    "language": {
      "const": "ac-process/0.1"
    },
    "process_id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "execution_profile_ref": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/condition"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "ir_version",
    "language",
    "process_id",
    "environment_ref",
    "execution_profile_ref",
    "entry",
    "conditions",
    "nodes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "literal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quantity"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binding"
            },
            "binding_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "kind",
            "binding_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "index"
            },
            "registry_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "binding_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "kind",
            "registry_ref",
            "binding_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "duration": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
        },
        "unit": {
          "enum": [
            "s",
            "ms"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "read": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "parameter",
            "observation",
            "authorization"
          ]
        },
        "owner_ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "slot_ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "request_node_ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "source",
        "owner_ref",
        "key"
      ],
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "condition_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "kind",
            "condition_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "is"
            },
            "read": {
              "$ref": "#/$defs/read"
            },
            "equals": {
              "$ref": "#/$defs/literal"
            }
          },
          "required": [
            "kind",
            "read",
            "equals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "all"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "operands"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "any"
            },
            "operands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "operands"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not"
            },
            "operand": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "kind",
            "operand"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "seq"
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "minItems": 1
            }
          },
          "required": [
            "node_id",
            "kind",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "par"
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "minItems": 2
            }
          },
          "required": [
            "node_id",
            "kind",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "repeat"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "child": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "node_id",
            "kind",
            "count",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "delay"
            },
            "duration": {
              "$ref": "#/$defs/duration"
            }
          },
          "required": [
            "node_id",
            "kind",
            "duration"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "await"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            }
          },
          "required": [
            "node_id",
            "kind",
            "condition",
            "timeout"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "invoke"
            },
            "target_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "behavior_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            },
            "policy_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "node_id",
            "kind",
            "target_ref",
            "behavior_id",
            "arguments",
            "policy_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "with-control"
            },
            "control_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "policy_ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "child": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "node_id",
            "kind",
            "control_ref",
            "policy_ref",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "fail"
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "node_id",
            "kind",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "branch"
            },
            "mode": {
              "enum": [
                "ordered",
                "exclusive"
              ]
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/condition"
                  },
                  "child": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                  }
                },
                "required": [
                  "condition",
                  "child"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "otherwise": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "node_id",
            "kind",
            "mode",
            "timeout",
            "cases",
            "otherwise"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "Agentic Components ProcessIR 0.1"
}
