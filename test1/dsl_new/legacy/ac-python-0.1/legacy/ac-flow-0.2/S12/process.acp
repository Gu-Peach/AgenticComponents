; 四件双侧加工与转位交接流水
; 最多2件在途，PS1与PS2可加工不同工件，转台交接周期互斥。
(process "ac-flow/0.2" S12
  (sequence
    (parallel-for jobs job 2
      (sequence
        (await input_present $job.material $job.input 1800 tick)
        (with-resources
          (C1)
          (sequence
            (invoke op_089 C1 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await target_available PS1.work 1800 tick)
        (with-resources
          (PS1)
          (sequence
            (with-resources
              (R1 C1)
              (sequence
                (sequence
                  (invoke op_090 R1 transfer_material
                    (arg material $job.material)
                    (arg source C1.exit)
                    (arg target PS1.work))
                  (invoke op_091 R1 move_to_location
                    (arg target R1.home)))))
            (sequence
              (invoke op_092 PS1 clamp
                (arg material $job.material))
              (invoke op_093 PS1 process_material
                (arg material $job.material)
                (arg recipe side_a))
              (invoke op_094 PS1 unclamp
                (arg material $job.material)))
            (await target_available PS2.work 1800 tick)
            (with-resources
              (T1 R1 R2 PS2)
              (sequence
                (sequence
                  (invoke op_095 R1 transfer_material
                    (arg material $job.material)
                    (arg source PS1.work)
                    (arg target T1.slot1))
                  (invoke op_096 R1 move_to_location
                    (arg target R1.home)))
                (invoke op_097 T1 index_to_angle
                  (arg angle 3.141592653589793 rad))
                (sequence
                  (invoke op_098 R2 transfer_material
                    (arg material $job.material)
                    (arg source T1.slot1)
                    (arg target PS2.work))
                  (invoke op_099 R2 move_to_location
                    (arg target R2.home)))
                (invoke op_100 T1 index_to_angle
                  (arg angle 0.0 rad))))))
        (with-resources
          (PS2)
          (sequence
            (sequence
              (invoke op_101 PS2 clamp
                (arg material $job.material))
              (invoke op_102 PS2 process_material
                (arg material $job.material)
                (arg recipe side_b))
              (invoke op_103 PS2 unclamp
                (arg material $job.material)))
            (await target_available C2.entry 1800 tick)
            (with-resources
              (R2 C2)
              (sequence
                (sequence
                  (invoke op_104 R2 transfer_material
                    (arg material $job.material)
                    (arg source PS2.work)
                    (arg target C2.entry))
                  (invoke op_105 R2 move_to_location
                    (arg target R2.home)))))))
        (with-resources
          (C2)
          (sequence
            (invoke op_106 C2 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await output_departed $job.material C2 1800 tick)))
    (verify batch_goal)))
