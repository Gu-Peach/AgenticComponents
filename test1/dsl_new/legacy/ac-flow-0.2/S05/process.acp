; 四件双机器人去毛刺闭环
; 共用同一条进出料输送带，逐件循环；不假定存在独立回流通道。
(process "ac-flow/0.2" S05
  (sequence
    (for-each jobs job
      (sequence
        (await input_present $job.material $job.input 1800 tick)
        (with-resources
          (C1)
          (sequence
            (invoke op_023 C1 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (with-resources
          (R1 C1 F1)
          (sequence
            (sequence
              (invoke op_024 R1 transfer_material
                (arg material $job.material)
                (arg source C1.exit)
                (arg target F1.work))
              (invoke op_025 R1 move_to_location
                (arg target R1.home)))))
        (with-resources
          (R2 F1 D1)
          (sequence
            (sequence
              (invoke op_026 R2 transfer_material
                (arg material $job.material)
                (arg source F1.work)
                (arg target D1.work))
              (invoke op_027 R2 move_to_location
                (arg target R2.home)))))
        (with-resources
          (D1)
          (sequence
            (sequence
              (invoke op_028 D1 clamp
                (arg material $job.material))
              (invoke op_029 D1 process_material
                (arg material $job.material)
                (arg recipe deburr))
              (invoke op_030 D1 unclamp
                (arg material $job.material)))))
        (with-resources
          (R2 D1 C1)
          (sequence
            (sequence
              (invoke op_031 R2 transfer_material
                (arg material $job.material)
                (arg source D1.work)
                (arg target C1.entry))
              (invoke op_032 R2 move_to_location
                (arg target R2.home)))))
        (with-resources
          (C1)
          (sequence
            (invoke op_033 C1 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await output_departed $job.material C1 1800 tick)))
    (verify batch_goal)))
