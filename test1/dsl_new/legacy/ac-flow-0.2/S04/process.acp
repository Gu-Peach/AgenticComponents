; 四件双机械臂双输送带流水交接
; 最多2件在途，上游准备可与下游出料重叠；共享设备和目标容量互锁。
(process "ac-flow/0.2" S04
  (sequence
    (parallel-for jobs job 2
      (sequence
        (await input_present $job.material $job.input 1800 tick)
        (await target_available C1.entry 1800 tick)
        (with-resources
          (R1 S C1)
          (sequence
            (sequence
              (invoke op_017 R1 transfer_material
                (arg material $job.material)
                (arg source $job.input)
                (arg target C1.entry))
              (invoke op_018 R1 move_to_location
                (arg target R1.home)))))
        (with-resources
          (C1)
          (sequence
            (invoke op_019 C1 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await target_available C2.entry 1800 tick)
        (with-resources
          (R2 C1 C2)
          (sequence
            (sequence
              (invoke op_020 R2 transfer_material
                (arg material $job.material)
                (arg source C1.exit)
                (arg target C2.entry))
              (invoke op_021 R2 move_to_location
                (arg target R2.home)))))
        (with-resources
          (C2)
          (sequence
            (invoke op_022 C2 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await output_departed $job.material C2 1800 tick)))
    (verify batch_goal)))
