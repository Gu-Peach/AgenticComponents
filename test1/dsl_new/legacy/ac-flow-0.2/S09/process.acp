; 六件双机加工与单机器人互斥服务
; 任务按明确轮换分配到MC1/MC2，两机可并行加工，R1的上下料和退位均互斥。
(process "ac-flow/0.2" S09
  (sequence
    (parallel-for jobs job 2
      (sequence
        (await input_present $job.material $job.input 1800 tick)
        (with-resources
          (C1)
          (sequence
            (invoke op_066 C1 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await target_available $job.work 1800 tick)
        (with-resources
          ($job.machine)
          (sequence
            (with-resources
              (R1 C1)
              (sequence
                (sequence
                  (invoke op_067 R1 transfer_material
                    (arg material $job.material)
                    (arg source C1.exit)
                    (arg target $job.work))
                  (invoke op_068 R1 move_to_location
                    (arg target R1.home)))))
            (sequence
              (invoke op_069 $job.machine clamp
                (arg material $job.material))
              (invoke op_070 $job.machine process_material
                (arg material $job.material)
                (arg recipe $job.recipe))
              (invoke op_071 $job.machine unclamp
                (arg material $job.material)))
            (await target_available C2.entry 1800 tick)
            (with-resources
              (R1 C2)
              (sequence
                (sequence
                  (invoke op_072 R1 transfer_material
                    (arg material $job.material)
                    (arg source $job.work)
                    (arg target C2.entry))
                  (invoke op_073 R1 move_to_location
                    (arg target R1.home)))))))
        (with-resources
          (C2)
          (sequence
            (invoke op_074 C2 transport_to_exit
              (arg material $job.material)
              (arg speed_mps 0.2 m/s))))
        (await output_departed $job.material C2 1800 tick)))
    (verify batch_goal)))
