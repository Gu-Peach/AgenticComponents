{
  "contract_version": "1.1",
  "schema_type": "DeviceSpec",
  "schema_id": "standard.rotary_table",
  "device_spec_id": "standard.rotary_table",
  "version": "1.0.0",
  "device_type": "rotary_table",
  "display_name": "旋转台：工位定位与可选台面输送",
  "description": "依据三份规范定义的可复用声明模板；参数为示例值，节点/几何/提供者均需适配。",
  "asset": {
    "model_format": "glb",
    "model_key": "unbound/rotary_table",
    "binding_status": "requires_instance_asset_mapping"
  },
  "params_schema": {
    "rotate_speed_deg_s": {
      "type": "number",
      "required": true,
      "default": 90,
      "unit": "°/s",
      "min": 0.1,
      "max": 360,
      "mutability": "runtime_setpoint",
      "description": "角速度上限"
    },
    "rotate_accel_deg_s2": {
      "type": "number",
      "required": true,
      "default": 180,
      "unit": "°/s²",
      "min": 0.1,
      "max": 720,
      "mutability": "stopped_only",
      "description": "角加速度上限"
    },
    "angle_tolerance_deg": {
      "type": "number",
      "required": true,
      "default": 1,
      "unit": "°",
      "min": 0.001,
      "max": 5,
      "mutability": "stopped_only",
      "description": "定位误差阈值"
    },
    "settle_speed_deg_s": {
      "type": "number",
      "required": true,
      "default": 0.1,
      "unit": "°/s",
      "min": 0,
      "max": 5,
      "mutability": "stopped_only",
      "description": "到位稳定的角速度阈值"
    },
    "deck_radius_m": {
      "type": "number",
      "required": true,
      "default": 0.6,
      "unit": "m",
      "min": 0.05,
      "max": 5,
      "mutability": "stopped_only",
      "description": "转台支承面半径"
    },
    "max_payload_kg": {
      "type": "number",
      "required": true,
      "default": 50,
      "unit": "kg",
      "min": 0.01,
      "max": 5000,
      "mutability": "stopped_only",
      "description": "允许载荷"
    },
    "capacity": {
      "type": "integer",
      "required": true,
      "default": 2,
      "min": 1,
      "max": 50,
      "mutability": "stopped_only",
      "description": "允许同时承载数量"
    },
    "position_mode": {
      "type": "enum",
      "required": true,
      "default": "station",
      "options": [
        "station",
        "angle"
      ],
      "mutability": "stopped_only",
      "description": "工位号或角度设定"
    },
    "transfer_module": {
      "type": "boolean",
      "required": true,
      "default": false,
      "mutability": "stopped_only",
      "description": "是否含台面输送"
    },
    "deck_speed_mps": {
      "type": "number",
      "required": false,
      "default": 0.4,
      "unit": "m/s",
      "min": -3,
      "max": 3,
      "mutability": "runtime_setpoint",
      "description": "台面输送速度",
      "required_when": {
        "parameter": "transfer_module",
        "equals": true
      }
    }
  },
  "interfaces": [],
  "signal_ports": [
    {
      "port_id": "target_station",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "工位编号，通过 stations 映射到角度；不把字符串工位名直接作为 REAL",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "angleTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "任意目标角度，°；配置选择工位或角度模式，两者不同时驱动",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "°"
    },
    {
      "port_id": "rotate_to_station",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "原 command 的 PLC 投影；参数先写入，再请求一次定位，映射公共 execute 角色",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "request_id",
      "direction": "input",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "原 command 的 PLC 投影；参数先写入，再请求一次定位，映射公共 execute 角色",
      "signal_role": "request_parameter",
      "retention": "sampled_state"
    },
    {
      "port_id": "enableTag",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "转动使能；失能时按声明的减速保持策略处理，再使能后可继续原动作",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    },
    {
      "port_id": "reset",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "故障原因解除且允许恢复时复位",
      "signal_role": "request_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "actual_angle",
      "direction": "output",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "当前实际角度，°，用于到位和交接检查",
      "signal_role": "continuous_state",
      "retention": "sampled_state",
      "unit": "°"
    },
    {
      "port_id": "occupied",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "当前台面／指定交接区是否存在物料；作用范围必须在配置中固定",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "rotating",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "实际角速度是否超过静止容差",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "at_station",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "台面达到所选目标且已稳定；这是状态，不单独代表某次请求成功",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "accepted",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "continuous_state",
      "retention": "sampled_state"
    },
    {
      "port_id": "result_id",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "DINT",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "error_code",
      "direction": "output",
      "value_type": "integer",
      "plc_type": "INT",
      "description": "公共任务反馈，done 关联当前定位请求",
      "signal_role": "result_latched",
      "retention": "latched_until_ack_or_new_request"
    },
    {
      "port_id": "speedTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "台面输送速度；纯定位转台不提供该接口",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "m/s"
    },
    {
      "port_id": "speedFpmTag",
      "direction": "input",
      "value_type": "number",
      "plc_type": "REAL",
      "description": "台面输送速度；纯定位转台不提供该接口",
      "signal_role": "continuous_command",
      "retention": "sampled_state",
      "unit": "ft/min"
    },
    {
      "port_id": "transfer_enable",
      "direction": "input",
      "value_type": "boolean",
      "plc_type": "BOOL",
      "description": "台面出入料许可，与旋转使能分别定义",
      "signal_role": "continuous_command",
      "retention": "sampled_state"
    }
  ],
  "transport_behaviors": [
    {
