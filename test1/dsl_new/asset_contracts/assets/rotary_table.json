    {
      "behavior_id": "convey_on_deck",
      "display_name": "台面输送",
      "behavior_type": "action",
      "schedulable": true,
      "executor_ref": "pending.rotary_table.convey_on_deck",
      "implementation_status": "pending_adapter",
      "arguments_schema": {},
      "trigger": {
        "description": "transfer_enable 和有效速度设定",
