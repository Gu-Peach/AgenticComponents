            "left": {
              "source": "signal",
              "ref": "interlock_ok"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          }
        ],
        "sustaining_conditions": [
          {
            "id": "enabled",
            "left": {
              "source": "signal",
              "ref": "enable"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          },
          {
            "id": "operation_authorized",
            "left": {
              "source": "authorization",
              "ref": "operation_allowed"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          },
          {
            "id": "clamping_maintained",
            "left": {
              "source": "observation",
              "ref": "subject_clamped",
              "bindings": {
                "material": "material"
              }
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          },
          {
            "id": "interlock_maintained",
            "left": {
              "source": "signal",
              "ref": "interlock_ok"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          }
        ],
        "completion": {
          "mode": "evidence",
          "checks": [
            {
              "id": "cycle_evidence",
              "left": {
                "source": "signal",
                "ref": "cycle_finished"
              },
              "operator": "eq",
              "right": {
                "source": "literal",
                "value": true
              }
            },
            {
              "id": "matching_operation",
              "left": {
                "source": "observation",
                "ref": "operation_recorded",
                "bindings": {
                  "material": "material",
                  "recipe": "recipe"
                }
              },
              "operator": "eq",
              "right": {
                "source": "literal",
                "value": true
              }
            },
            {
              "id": "process_stopped",
              "left": {
                "source": "observation",
                "ref": "process_stopped"
              },
              "operator": "eq",
              "right": {
                "source": "literal",
                "value": true
              }
            }
          ],
          "description": "当前请求、指定工件和配方的完成证据一致。抽象计时模型只证明其声明的模拟工序完成。"
        },
        "expected_effects": [
          "向指定物料记录本次配方工序；不自动松夹或搬走工件。"
        ],
        "failure_policy": "preserve_observed_state_and_report"
