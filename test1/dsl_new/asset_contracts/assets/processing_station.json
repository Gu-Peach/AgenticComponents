          },
          {
            "id": "operation_authorized",
            "left": {
              "source": "authorization",
              "ref": "operation_allowed"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          },
          {
            "id": "subject_present",
            "left": {
              "source": "observation",
              "ref": "subject_present",
              "bindings": {
                "material": "material"
              }
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": true
            }
          },
          {
            "id": "payload_within_limit",
            "left": {
              "source": "observation",
              "ref": "material_mass",
              "bindings": {
                "material": "material"
              }
            },
            "operator": "le",
            "right": {
              "source": "parameter",
              "ref": "max_payload_kg"
            }
          },
          {
            "id": "clamped",
            "left": {
              "source": "observation",
              "ref": "subject_clamped",
              "bindings": {
                "material": "material"
              }
            },
            "operator": "eq",
            "right": {
              "source": "literal",
