            "left": {
              "source": "signal",
              "ref": "error"
            },
            "operator": "eq",
            "right": {
              "source": "literal",
              "value": false
            }
          },
          {
            "id": "enabled",
            "left": {
              "source": "signal",
              "ref": "enable"
            },
            "operator": "eq",
